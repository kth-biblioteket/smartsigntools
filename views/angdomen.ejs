<html>

<head>
    <%- include('partials/angdomenhead'); %>
</head>

<body>
    <% if (smartsignconfig.image) { %>
        <div class="App">
            <img src="/smartsigntools/images/angdomen_1080_1920.png" alt="Ångdomen">
        </div>
    <% } else { %>
        <div class="App">
            <% if (!smartsignconfig.kiosk) { %>
                <div class="App-title App-padding content-top">
                    <div class="kthlogo">
                        <img src="/smartsigntools/images/kthlogo_vit.svg">
                    </div>
                    <div class="rubrik">Ångdomen today</div>
                </div>
                <% } %>
                <div id="App-content" class="App-content content-padding">
                    <div id="lokalbokningar" class="lokalbokningar">
                    </div>
                </div>
                <div class="App-footer content-padding">
                </div>
                <div id="debuginfo">
                </div>
        </div>
        <%- include('partials/angdomenscript'); %>
    <% } %>
</body>

</html>